# Kavish Career OS — Environment Configuration Template

# Server Configuration
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Persistence Configuration
# SQLite local development default:
DATABASE_URL=sqlite+aiosqlite:///./career_os.db
# PostgreSQL production configuration:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/career_os

# AI Engine Credentials (Optional, offline rule fallback if not set)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google Sheets Operational Sync (Optional)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# Outbound Email SMTP (Optional - Level 2 Human Approval strictly enforced)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
